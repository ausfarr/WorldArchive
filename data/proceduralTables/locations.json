  "descriptorLineTemplates": [
    { "value": "Nobody planned for it to end up like this. Nobody's fixed it either.", "weight": 1, "genre": ["universal"] },
    { "value": "Whatever this place used to be, it's had a long time to become something else.", "weight": 1, "genre": ["universal"] },
    { "value": "Quiet in a way that puts people on edge, and probably should.", "weight": 1, "genre": ["universal"] },
    { "value": "Still standing, mostly out of spite.", "weight": 1, "genre": ["universal"] },
    { "value": "The kind of place people pass through fast, or not at all.", "weight": 1, "genre": ["universal"] }
  ],
  "notableFeaturesTemplates": [
    { "value": "A tangle of {regionBiome} that's been picked over more than once, but never quite cleaned out. Whatever's left is worth the risk to whoever gets there first.", "weight": 1, "genre": ["universal"] },
    { "value": "The layout here rewards knowing it -- shortcuts, blind spots, and at least one route that isn't on any map still in circulation. Getting turned around in {regionBiome} like this can cost more than time.", "weight": 1, "genre": ["universal"] },
    { "value": "Signs of recent activity are everywhere -- fresh tracks, disturbed debris, a fire pit still warm. Something is using this stretch of {regionBiome}, regularly.", "weight": 1, "genre": ["universal"] },
    { "value": "Half-collapsed and half-improvised into something livable, this corner of {regionBiome} has clearly been claimed by someone, even if they're not obviously present right now.", "weight": 1, "genre": ["universal"] },
    { "value": "Old signage and structural bones hint at what this {regionBiome} used to serve, before whatever happened here happened.", "weight": 1, "genre": ["universal"] },

    { "value": "Faint ley-line resonance hums through this stretch of {regionBiome}, strong enough that hedge-mages can feel it from the road. Whether that's a blessing or a warning depends who you ask.", "weight": 1, "genre": ["fantasy"] },
    { "value": "Old wardstones, half-sunk and moss-grown, ring the edges of this {regionBiome} -- someone meant to keep something in, or out, and never got around to renewing the working.", "weight": 1, "genre": ["fantasy"] },
    { "value": "The local wildlife gives this {regionBiome} a wide berth, which the more superstitious locals take as proof enough of what's really out there.", "weight": 1, "genre": ["fantasy"] },
    { "value": "Weathered runes are carved into every standing surface of this {regionBiome}, in a script no scholar who's passed through has been able to fully place.", "weight": 1, "genre": ["fantasy"] },

    { "value": "Derelict systems still cycle through this {regionBiome} on backup power, running routines for a crew that's been gone for years.", "weight": 1, "genre": ["scifi"] },
