  "traitsPool": [
    { "value": { "name": "Keen Senses", "description": "The creature has advantage on Wisdom (Perception) checks that rely on sight, hearing, or smell." }, "archetypes": ["feral", "skulker", "skirmisher"], "weight": 3, "genre": ["universal"] },
    { "value": { "name": "Pack Tactics", "description": "The creature has advantage on an attack roll against a creature if at least one of the creature's allies is within 5 feet of the target and the ally isn't incapacitated." }, "archetypes": ["feral", "skulker"], "weight": 3, "genre": ["universal"] },
    { "value": { "name": "Amphibious", "description": "The creature can breathe air and water." }, "archetypes": ["brute", "feral"], "weight": 1, "genre": ["universal"] },
    { "value": { "name": "Magic Resistance", "description": "The creature has advantage on saving throws against spells and other magical effects." }, "archetypes": ["arcane", "guardian"], "weight": 1, "genre": ["universal"] },
    { "value": { "name": "Regeneration", "description": "The creature regains 5 hit points at the start of its turn if it has at least 1 hit point." }, "archetypes": ["brute", "guardian"], "weight": 1, "genre": ["universal"] },
    { "value": { "name": "Sunlight Sensitivity", "description": "While in sunlight, the creature has disadvantage on attack rolls, as well as on Wisdom (Perception) checks that rely on sight." }, "archetypes": ["skulker", "arcane"], "weight": 2, "genre": ["universal"] },
    { "value": { "name": "Undead Fortitude", "description": "If damage reduces the creature to 0 hit points, it must make a Constitution saving throw with a DC of 5 + the damage taken, unless the damage is radiant or from a critical hit. On a success, it drops to 1 hit point instead." }, "archetypes": ["brute", "guardian"], "weight": 1, "genre": ["universal"] },
    { "value": { "name": "Charge", "description": "If the creature moves at least 20 feet straight toward a target and then hits it with an attack on the same turn, the target takes an extra 5 damage." }, "archetypes": ["brute", "feral"], "weight": 2, "genre": ["universal"] },
    { "value": { "name": "Spider Climb", "description": "The creature can climb difficult surfaces, including upside down on ceilings, without needing to make an ability check." }, "archetypes": ["skulker"], "weight": 1, "genre": ["universal"] },
    { "value": { "name": "Innate Spellcasting", "description": "The creature's innate spellcasting ability is Charisma. It can innately cast a handful of minor spells, requiring no material components." }, "archetypes": ["arcane"], "weight": 2, "genre": ["universal"] },
    { "value": { "name": "False Appearance", "description": "While motionless, the creature is indistinguishable from an ordinary object of its surroundings." }, "archetypes": ["skulker", "arcane"], "weight": 1, "genre": ["universal"] }
  ],
  "_traitsPoolNote": "Deliberately NOT genre-tagged -- these are 5e mechanical trait shapes (advantage on X, resistance to Y), and their existing wording already reads fine reflavored into any genre (a 'Sunlight Sensitivity' works equally for a vampire, an irradiated mutant, or a light-averse xenomorph).",
  "flavorTemplates": [
    { "value": "{name} moves like something that hasn't fully decided it's alive.", "genre": ["universal"] },
    { "value": "Locals give {name} a wide berth, and the ones who don't rarely explain why not twice.", "genre": ["universal"] },
    { "value": "{name} was ordinary once, before whatever this world did to it.", "genre": ["universal"] },
    { "value": "There's a rhythm to how {name} hunts -- patient, then all at once.", "genre": ["universal"] },
    { "value": "{name} keeps to the margins of the map, where nobody bothers to draw the lines carefully.", "genre": ["universal"] },
    { "value": "Something about {name} suggests it remembers being something else.", "genre": ["universal"] },
    { "value": "{name} doesn't so much attack as arrive at a conclusion.", "genre": ["universal"] },
    { "value": "The old kingdom's bestiaries have a name for {name}, and it isn't a kind one.", "genre": ["fantasy"] },
    { "value": "{name} was picked apart by the wasteland long before it ever picked a fight.", "genre": ["post_apoc"] },
    { "value": "Nobody's sure whether {name} was built, grown, or something in between.", "genre": ["scifi"] },
    { "value": "{name} keeps turning up on the same three blocks, and the police reports never quite agree on what it is.", "genre": ["modern"] },
    { "value": "The thing about {name} is that describing it accurately makes people not want to look for it.", "genre": ["horror"] }
  ],
  "designNotes": [
    { "value": "Procedurally rolled -- a solid stat block, worth a manual pass on its traits/flavor before running it in a real session.", "weight": 1 }
